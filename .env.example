REGENT_ENVIRONMENT=development
REGENT_DATABASE_URL=postgresql+psycopg://regent:regent@localhost:5432/regent
REGENT_LOG_LEVEL=INFO
REGENT_WORKER_POLL_SECONDS=1.0
REGENT_WORKER_LEASE_SECONDS=30

# P1 generation and isolated build
REGENT_WORKSPACE_ROOT=/var/lib/regent/workspaces
REGENT_BUILD_ROOT=/var/lib/regent/builds
REGENT_ARTIFACT_ROOT=/var/lib/regent/artifacts
# CD-6: Path B (compose) defaults to local — no docker.sock required.
# Path A production host worker: REGENT_SANDBOX_MODE=docker + agent-exec image.
REGENT_SANDBOX_MODE=local
REGENT_SANDBOX_IMAGE=regent-python-web-v1-sandbox:1
REGENT_AGENT_SANDBOX_IMAGE=regent-agent-exec-v1:1
# Required when sandbox_mode=docker inside a container (N-3d):
# REGENT_HOST_PATH_MAP=/var/lib/regent=/opt/regent
# Optional uid:gid override (CD-6.2); empty = process uid on Linux
# REGENT_AGENT_SANDBOX_UID=
REGENT_DEPENDENCY_RESOLVER_IMAGE=regent-python-web-v1-resolver:1
# Required for dependency materialization AND agent pip/curl network (CD-7.5);
# leave unset to fail closed (no bare bridge / no ACQUIRE download).
# REGENT_DEPENDENCY_EGRESS_PROXY=http://dependency-egress-proxy:3128
# REGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
# REGENT_EVIDENCE_EGRESS_PROXY=http://dependency-egress-proxy:3128
REGENT_EVIDENCE_MAX_BYTES=262144
REGENT_SCHEDULER_ENABLED=true
# REGENT_SCHEDULER_ORG_KEYS=default,demo

# CD-7.3 persona split (DecisionNote D5):
# REGENT_DELIVERY_PROFILE — recovery ladder + agentic turn budget (authority for CD-7)
# REGENT_DECISION_PREFERENCE — confirmation / HumanTask timeout policy
# REGENT_DELIVERY_PROFILE=balanced
# REGENT_DECISION_PREFERENCE=balanced

REGENT_AAR1_PHASE=contract
REGENT_AAR1_SHADOW_LOG_DIVERGENCES=true
# REGENT_AAR1_ENVELOPE_HMAC_KEY=
# REGENT_REQUIRE_RELEASE_HUMAN_APPROVAL=true
# REGENT_RECONCILIATION_INTERVAL_SECONDS=300
# REGENT_PRIVACY_CONSENT_ENFORCED=true
# REGENT_PRIVACY_RETENTION_DAYS=90
# REGENT_PRIVACY_RETENTION_INTERVAL_SECONDS=3600
# REGENT_AAR1_CERTIFIED_HIVE=true

# Remote deploy (never commit real secrets)
# SERVER_IP=
# LOGIN_USER=
# LOGIN_PASSWORD=
