REGENT_ENVIRONMENT=development
REGENT_DATABASE_URL=postgresql+psycopg://regent:regent@localhost:5432/regent
REGENT_LOG_LEVEL=INFO
REGENT_WORKER_POLL_SECONDS=1.0
REGENT_WORKER_LEASE_SECONDS=30

# P1 generation and isolated build
REGENT_WORKSPACE_ROOT=/var/lib/regent/workspaces
REGENT_BUILD_ROOT=/var/lib/regent/builds
REGENT_SANDBOX_IMAGE=regent-python-web-v1-sandbox:1
REGENT_DEPENDENCY_RESOLVER_IMAGE=regent-python-web-v1-resolver:1
# Required for dependency materialization; leave unset to fail closed.
# REGENT_DEPENDENCY_EGRESS_PROXY=http://dependency-egress-proxy:3128
# REGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
# REGENT_EVIDENCE_EGRESS_PROXY=http://dependency-egress-proxy:3128
# Platform host allowlist for Goal-authorized URL fetches (not a Core feed catalog):
REGENT_EVIDENCE_MAX_BYTES=262144
# P2 scheduler worker tick (empty = discover org_keys from QUEUED entries)
REGENT_SCHEDULER_ENABLED=true
# REGENT_SCHEDULER_ORG_KEYS=default,demo

# AAR-1 Foundation phase: expand | dual_write | read_switch | enforce | contract
# ROLLOUT_NOT_ALLOWED: do not treat this as adaptive multi-agent default.
REGENT_AAR1_PHASE=contract
REGENT_AAR1_SHADOW_LOG_DIVERGENCES=true
# REGENT_AAR1_ENVELOPE_HMAC_KEY=
# When set, AgentEnvelope / AgentMesh require envelope_v1 HMAC-SHA256.
# REGENT_REQUIRE_RELEASE_HUMAN_APPROVAL=true
# REGENT_RECONCILIATION_INTERVAL_SECONDS=300
# Opt-in certified fixed hive (pm-dev-independent-qa-v1) when platform caps are VERIFIED.
# Default OFF = single-agent champion (required for P0 baseline).
# Enabling this does NOT authorize adaptive free-form topology (ROLLOUT_NOT_ALLOWED).
# Uncomment only for explicit fixed-template experiments:
# REGENT_AAR1_CERTIFIED_HIVE=true

# Remote deploy (never commit real secrets; export these in the shell or a local .env)
# SERVER_IP=
# LOGIN_USER=
# LOGIN_PASSWORD=
