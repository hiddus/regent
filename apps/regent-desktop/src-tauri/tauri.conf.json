{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Regent Desktop",
  "version": "1.0.0",
  "identifier": "com.regent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "title": "Regent Desktop",
    "windows": [
      {
        "title": "Regent Desktop - AI Agent for Product Development",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2024 Regent. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "AI Agent for Product Development",
    "longDescription": "Regent Desktop is an AI-powered agent that helps you build products through natural conversation. It handles discovery, requirements, generation, and deployment in a governed, observable workflow."
  }
}
